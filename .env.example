# Node HTTP listener; defaults to 3000 locally. Vercel supplies PORT.
PORT=3000

# Shared key required for write endpoints in production; optional for local development.
SAFEGUARD_API_KEY=replace-with-a-long-random-secret

# Production Turso/libSQL database. Leave unset locally to use safeguard.db.
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-auth-token

# Optional API behavior tuning.
SAFEGUARD_OFFLINE_SECONDS=30
SAFEGUARD_ALERT_COOLDOWN_SECONDS=60
SAFEGUARD_DEBOUNCE_READINGS=3
SAFEGUARD_HYSTERESIS_RATIO=0.9
SAFEGUARD_RETENTION_DAYS=7

# Optional simulator settings; defaults target the local server and demo room.
SAFEGUARD_API_URL=http://localhost:3000/api/readings
SIMULATOR_ROOM=Ruang Demo
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_MAX_READINGS=0

# Vercel automatically sets VERCEL=1 in its runtime; do not set it locally.
